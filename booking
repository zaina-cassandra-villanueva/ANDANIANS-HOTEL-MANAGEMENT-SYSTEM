<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Andanian's Hotel · Pangasinan</title>
<link href="https://fonts.googleapis.com/css2?family=Yeseva+One&family=DM+Serif+Display:ital@0;1&family=Nunito:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/*=== RESET & ROOT ===*/
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --deep:#0a1628;--navy:#112240;--navy2:#1b2f4a;
  --teal:#0d7377;--teal2:#14a085;--teal3:#1abc9c;
  --gold:#e8a020;--gold2:#f0b840;--gold3:#ffd166;
  --peach:#ff6b6b;--peach2:#ff8e8e;
  --sand:#fef3e2;--sand2:#fde8c0;--sand3:#f5d89a;
  --cream:#f9f6f0;--white:#ffffff;
  --text:#1a2332;--text2:#344563;--muted:#6b7c93;--muted2:#9aabbd;
  --border:rgba(13,115,119,0.15);--border2:rgba(13,115,119,0.28);
  --glass:rgba(255,255,255,0.08);--glass2:rgba(255,255,255,0.14);
  --success:#00b894;--danger:#e17055;
  --r:18px;--r-sm:12px;--r-xs:8px;
  --tab:70px;--shadow:0 4px 24px rgba(10,22,40,0.12);--shadow2:0 8px 40px rgba(10,22,40,0.18);
}
html{-webkit-tap-highlight-color:transparent;scroll-behavior:smooth}
body{font-family:'Nunito',sans-serif;background:var(--cream);color:var(--text);max-width:430px;margin:0 auto;min-height:100vh;overflow-x:hidden;position:relative}

/*=== SPLASH ===*/
#splash{position:fixed;inset:0;background:var(--deep);z-index:9999;display:flex;flex-direction:column;align-items:center;justify-content:center;transition:opacity .6s,transform .6s}
#splash.hide{opacity:0;transform:scale(1.04);pointer-events:none}
.splash-wave{position:absolute;bottom:0;left:0;right:0;height:120px;overflow:hidden}
.splash-wave svg{width:200%;animation:waveMove 3s linear infinite}
@keyframes waveMove{to{transform:translateX(-50%)}}
.splash-logo{font-family:'Yeseva One',serif;font-size:36px;color:var(--white);text-align:center;line-height:1.1;animation:splashIn .8s cubic-bezier(.34,1.56,.64,1) both}
.splash-sub{font-size:13px;color:rgba(255,255,255,.55);letter-spacing:.18em;text-transform:uppercase;margin-top:8px;animation:splashIn .8s .15s cubic-bezier(.34,1.56,.64,1) both}
.splash-em{color:var(--gold3);font-style:italic}
.splash-dot{display:flex;gap:7px;margin-top:28px;animation:splashIn .8s .3s both}
.splash-dot span{width:8px;height:8px;border-radius:50%;background:var(--gold3);animation:dotPulse 1.2s ease-in-out infinite}
.splash-dot span:nth-child(2){animation-delay:.2s}
.splash-dot span:nth-child(3){animation-delay:.4s}
@keyframes dotPulse{0%,80%,100%{transform:scale(.7);opacity:.4}40%{transform:scale(1);opacity:1}}
@keyframes splashIn{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:none}}

/*=== SCREENS ===*/
.screen{display:none;flex-direction:column;min-height:100vh;animation:screenIn .35s ease both}
.screen.active{display:flex}
@keyframes screenIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.scroll-area{flex:1;overflow-y:auto;-webkit-overflow-scrolling:touch;padding-bottom:calc(var(--tab) + 20px)}
.scroll-area::-webkit-scrollbar{display:none}

/*=== BOTTOM NAV ===*/
.bnav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:430px;height:var(--tab);background:var(--white);border-top:1px solid var(--border);display:flex;align-items:center;z-index:200;padding-bottom:env(safe-area-inset-bottom,0);box-shadow:0 -4px 24px rgba(10,22,40,0.08)}
.bnav-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;border:none;background:none;cursor:pointer;padding:8px 0;color:var(--muted);font-family:'Nunito',sans-serif;font-size:9.5px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;position:relative;transition:color .2s}
.bnav-btn svg{width:22px;height:22px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;transition:all .25s}
.bnav-btn.active{color:var(--teal)}
.bnav-btn.active svg{stroke:var(--teal);transform:translateY(-2px)}
.bnav-pip{position:absolute;top:7px;right:calc(50% - 18px);width:6px;height:6px;border-radius:50%;background:var(--gold);opacity:0;transition:opacity .2s}
.bnav-btn.active .bnav-pip{opacity:1}
.bnav-center-btn{width:54px;height:54px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--teal2));box-shadow:0 4px 16px rgba(13,115,119,.5);border:3px solid var(--white);position:absolute;left:50%;transform:translateX(-50%) translateY(-20px);cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;-webkit-tap-highlight-color:transparent}
.bnav-center-btn:active{transform:translateX(-50%) translateY(-20px) scale(.92)}
.bnav-center-btn svg{width:26px;height:26px;stroke:white;fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/*=== HERO ===*/
.hero{background:linear-gradient(165deg,var(--deep) 0%,var(--navy) 50%,#0a2a4a 100%);padding:52px 22px 32px;position:relative;overflow:hidden}
.hero-waves{position:absolute;bottom:-1px;left:0;right:0;pointer-events:none}
.hero-particles{position:absolute;inset:0;pointer-events:none;overflow:hidden}
.particle{position:absolute;width:3px;height:3px;border-radius:50%;background:var(--gold3);opacity:.4;animation:particleFloat linear infinite}
@keyframes particleFloat{0%{transform:translateY(0) translateX(0);opacity:.4}50%{opacity:.8}100%{transform:translateY(-80px) translateX(20px);opacity:0}}
.hero-badge{display:inline-flex;align-items:center;gap:6px;background:var(--glass2);backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.18);border-radius:30px;padding:5px 14px;font-size:11px;font-weight:700;color:var(--gold3);letter-spacing:.08em;text-transform:uppercase;margin-bottom:14px;animation:badgeIn .7s ease both}
@keyframes badgeIn{from{opacity:0;transform:scale(.88)}to{opacity:1;transform:scale(1)}}
.hero-name{font-family:'Yeseva One',serif;font-size:38px;color:var(--white);line-height:1.0;animation:heroName .8s ease both}
.hero-name em{color:var(--gold3);font-style:italic;font-family:'DM Serif Display',serif}
@keyframes heroName{from{opacity:0;transform:translateX(-16px)}to{opacity:1;transform:none}}
.hero-loc{font-size:12px;color:rgba(255,255,255,.6);letter-spacing:.1em;text-transform:uppercase;margin-top:6px;display:flex;align-items:center;gap:5px;animation:heroName .8s .1s both}
.hero-desc{font-size:13px;color:rgba(255,255,255,.65);margin-top:10px;line-height:1.7;max-width:310px;animation:heroName .8s .2s both}
.hero-stats{display:flex;gap:20px;margin-top:18px;animation:heroName .8s .3s both}
.hstat{text-align:center}
.hstat-num{font-family:'Yeseva One',serif;font-size:22px;color:var(--gold3);line-height:1}
.hstat-lbl{font-size:10px;color:rgba(255,255,255,.5);letter-spacing:.06em;text-transform:uppercase;font-weight:700;margin-top:2px}

/*=== SECTION ===*/
.sec{padding:22px 18px 0}
.sec-hd{display:flex;align-items:baseline;justify-content:space-between;margin-bottom:14px}
.sec-title{font-family:'DM Serif Display',serif;font-size:23px;color:var(--text)}
.sec-link{font-size:12px;color:var(--teal);font-weight:700;background:none;border:none;cursor:pointer;letter-spacing:.02em}

/*=== ROOM CARD ===*/
.rcard{background:var(--white);border-radius:var(--r);border:1.5px solid var(--border);margin-bottom:18px;overflow:hidden;cursor:pointer;transition:all .22s cubic-bezier(.34,.68,.64,1);box-shadow:var(--shadow)}
.rcard:active{transform:scale(.978) translateY(2px)}
.rcard:hover{border-color:var(--teal2);box-shadow:var(--shadow2)}
.rcard-img{height:190px;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
.rcard-img::after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(10,22,40,.7) 0%,transparent 55%)}
.rcard-tags{position:absolute;top:12px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:flex-start;z-index:2}
.rtag{display:inline-flex;align-items:center;gap:4px;background:rgba(255,255,255,.18);backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.22);color:white;font-size:10.5px;font-weight:800;padding:4px 10px;border-radius:20px;letter-spacing:.04em;text-transform:uppercase}
.rtag.gold{background:rgba(232,160,32,.85);border-color:rgba(232,160,32,.4)}
.rcard-overlay{position:absolute;bottom:0;left:0;right:0;z-index:2;padding:14px 16px 0}
.rcard-name-hero{font-family:'DM Serif Display',serif;font-size:22px;color:white;line-height:1.1}
.rcard-price-hero{font-size:13px;color:rgba(255,255,255,.75);font-weight:600;margin-top:2px;margin-bottom:14px}
.rcard-body{padding:14px 16px}
.rcard-row{display:flex;justify-content:space-between;align-items:center}
.rcard-sqm{font-size:12px;color:var(--muted);font-weight:600}
.cap-chip{display:flex;align-items:center;gap:4px;background:var(--sand);border:1px solid var(--sand3);border-radius:20px;padding:4px 10px;font-size:12px;font-weight:800;color:var(--text2)}
.rcard-feats{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0}
.rfeat{font-size:11px;background:#f0f8ff;border:1px solid rgba(13,115,119,.15);color:var(--teal);padding:3px 9px;border-radius:20px;font-weight:700}
.rcard-footer{display:flex;align-items:center;justify-content:space-between;border-top:1px solid var(--border);padding-top:12px;margin-top:2px}
.rcard-price .amt{font-family:'Yeseva One',serif;font-size:28px;color:var(--teal);line-height:1}
.rcard-price .per{font-size:11px;color:var(--muted);font-weight:600}
.sel-btn{background:linear-gradient(135deg,var(--teal),var(--teal2));color:white;border:none;border-radius:var(--r-sm);padding:12px 20px;font-family:'Nunito',sans-serif;font-size:14px;font-weight:800;cursor:pointer;transition:all .18s;box-shadow:0 3px 12px rgba(13,115,119,.35);letter-spacing:.01em}
.sel-btn:active{transform:scale(.94);box-shadow:none}

/*=== ROOM ART ===*/
.ra1{background:linear-gradient(145deg,#0a1628 0%,#112240 50%,#0d3350 100%)}
.ra2{background:linear-gradient(145deg,#1a3a1a 0%,#0d4020 50%,#1a5030 100%)}
.ra3{background:linear-gradient(145deg,#3a1a0a 0%,#4a2010 50%,#5a3520 100%)}
.ra4{background:linear-gradient(145deg,#1a0a3a 0%,#2a1050 50%,#3a1548 100%)}

/*=== STEP FLOW ===*/
.sbar{background:var(--white);padding:12px 18px 10px;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(10,22,40,.05)}
.sbar-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.sbar-name{font-size:13px;font-weight:800;color:var(--teal)}
.sbar-count{font-size:12px;color:var(--muted);font-weight:600}
.sbar-steps{display:flex;gap:4px}
.sseg{flex:1;height:5px;border-radius:3px;background:var(--cream);transition:background .4s,transform .2s;transform-origin:left}
.sseg.done{background:var(--teal3)}
.sseg.active{background:linear-gradient(90deg,var(--teal),var(--gold));animation:segPulse 1.8s ease-in-out infinite}
@keyframes segPulse{0%,100%{opacity:1}50%{opacity:.75}}

/*=== STEP ICONS (breadcrumb) ===*/
.step-crumbs{display:flex;align-items:center;overflow-x:auto;padding:10px 18px;gap:0;scrollbar-width:none;border-bottom:1px solid var(--border);background:var(--white)}
.step-crumbs::-webkit-scrollbar{display:none}
.scrumb{display:flex;align-items:center;gap:0;flex-shrink:0}
.scrumb-dot{width:28px;height:28px;border-radius:50%;background:var(--cream);border:2px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:13px;transition:all .25s;flex-shrink:0}
.scrumb-dot.done{background:var(--teal3);border-color:var(--teal3);color:white}
.scrumb-dot.active{background:var(--teal);border-color:var(--teal);transform:scale(1.15);box-shadow:0 0 0 4px rgba(13,115,119,.18)}
.scrumb-line{width:24px;height:2px;background:var(--border);margin:0 2px;transition:background .3s}
.scrumb-line.done{background:var(--teal3)}
.scrumb-label{font-size:9px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin-top:3px;white-space:nowrap}

/*=== CARDS & INPUTS ===*/
.card{background:var(--white);border-radius:var(--r);border:1.5px solid var(--border);padding:18px;margin-bottom:14px;box-shadow:var(--shadow)}
.card-title{font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:13px;display:flex;align-items:center;gap:7px}
.flabel{font-size:11px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin-bottom:7px;display:block}
.finput{width:100%;background:var(--cream);border:1.5px solid var(--border);border-radius:var(--r-sm);color:var(--text);font-family:'Nunito',sans-serif;font-size:15px;font-weight:600;padding:13px 15px;outline:none;transition:all .2s;-webkit-appearance:none;appearance:none}
.finput:focus{border-color:var(--teal);background:white;box-shadow:0 0 0 3px rgba(13,115,119,.1)}
.frow{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fgroup{margin-bottom:14px}
textarea.finput{resize:none}

/*=== DATE CARDS ===*/
.date-cards{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px}
.dcard{background:var(--cream);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:13px 14px;position:relative;cursor:pointer;transition:all .2s}
.dcard.has-val{background:white;border-color:var(--teal)}
.dcard-lbl{font-size:10px;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.07em;margin-bottom:5px}
.dcard-inp{width:100%;background:transparent;border:none;outline:none;font-family:'Nunito',sans-serif;font-size:14px;font-weight:800;color:var(--text);padding:0;cursor:pointer;-webkit-appearance:none}
.dcard-inp::-webkit-calendar-picker-indicator{opacity:0;position:absolute;inset:0;width:100%;height:100%;cursor:pointer}

/*=== NIGHT PILL ===*/
.night-pill{background:linear-gradient(135deg,var(--teal),var(--teal2));color:white;border-radius:var(--r-sm);padding:14px 18px;display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;transition:all .3s}
.np-nights{display:flex;align-items:baseline;gap:5px}
.np-num{font-family:'Yeseva One',serif;font-size:32px;line-height:1}
.np-lbl{font-size:13px;opacity:.8;font-weight:600}
.np-total{text-align:right}
.np-total-amt{font-family:'DM Serif Display',serif;font-size:22px;font-weight:700}
.np-total-lbl{font-size:11px;opacity:.75;font-weight:600}

/*=== STEPPER ===*/
.stepper-row{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:14px 16px;display:flex;align-items:center;justify-content:space-between;box-shadow:var(--shadow)}
.stepper-row .info strong{display:block;font-size:15px;font-weight:800}
.stepper-row .info small{font-size:12px;color:var(--muted);font-weight:600}
.stepper{display:flex;align-items:center;gap:16px}
.step-b{width:36px;height:36px;border-radius:50%;background:var(--cream);border:1.5px solid var(--border);font-size:20px;color:var(--text);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s;font-weight:300;user-select:none}
.step-b:active{transform:scale(.85);background:var(--sand)}
.step-n{font-size:22px;font-weight:800;color:var(--teal);min-width:26px;text-align:center}

/*=== ADDON CARDS ===*/
.addon{background:var(--white);border:2px solid var(--border);border-radius:var(--r);padding:15px 16px;display:flex;align-items:flex-start;gap:13px;margin-bottom:12px;cursor:pointer;transition:all .2s;position:relative;overflow:hidden}
.addon::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(13,115,119,.04),transparent);opacity:0;transition:opacity .2s}
.addon.sel{border-color:var(--teal);box-shadow:0 0 0 1px var(--teal)}
.addon.sel::before{opacity:1}
.addon:active{transform:scale(.99)}
.addon-ico{width:46px;height:46px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:23px;flex-shrink:0;transition:transform .2s}
.addon.sel .addon-ico{transform:scale(1.08)}
.addon-body{flex:1;min-width:0}
.addon-name{font-size:15px;font-weight:800;color:var(--text)}
.addon-desc{font-size:12px;color:var(--muted);margin-top:3px;line-height:1.55;font-weight:500}
.addon-price{font-size:14px;font-weight:800;color:var(--teal);margin-top:7px}
.addon-cb{width:26px;height:26px;border-radius:50%;border:2px solid var(--border);background:var(--cream);display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0;margin-top:2px}
.addon.sel .addon-cb{background:var(--teal);border-color:var(--teal)}
.addon-cb svg{width:14px;height:14px;stroke:white;fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round;opacity:0;transition:all .2s;transform:scale(.5)}
.addon.sel .addon-cb svg{opacity:1;transform:scale(1)}

/*=== PROMO ===*/
.promo-wrap{display:flex;gap:8px;margin-bottom:8px}
.promo-inp{flex:1;background:var(--cream);border:1.5px solid var(--border);border-radius:var(--r-sm);font-family:'Nunito',sans-serif;font-size:14px;font-weight:800;color:var(--text);padding:12px 14px;outline:none;text-transform:uppercase;letter-spacing:.06em;transition:all .2s}
.promo-inp:focus{border-color:var(--teal);background:white}
.promo-btn{background:var(--teal);color:white;border:none;border-radius:var(--r-sm);padding:12px 16px;font-family:'Nunito',sans-serif;font-size:13px;font-weight:800;cursor:pointer;transition:all .18s;white-space:nowrap;letter-spacing:.02em}
.promo-btn:active{transform:scale(.94)}
.promo-ok{font-size:13px;font-weight:700;color:var(--success);display:none;padding:4px 0}
.promo-err{font-size:13px;font-weight:700;color:var(--danger);display:none;padding:4px 0}
.promo-hints{font-size:12px;color:var(--muted);font-weight:600;line-height:1.55}

/*=== SUMMARY ===*/
.price-row{display:flex;justify-content:space-between;align-items:baseline;font-size:14px;padding:5px 0;color:var(--muted);font-weight:600}
.price-row .v{color:var(--text);font-weight:700}
.price-row.disc .v{color:var(--success)}
.price-row.total{border-top:1.5px solid var(--border);margin-top:8px;padding-top:13px;font-size:17px;color:var(--text);font-weight:800}
.price-row.total .v{font-family:'Yeseva One',serif;font-size:26px;color:var(--teal)}

.room-mini{display:flex;align-items:center;gap:13px;padding:12px 0}
.rm-img{width:60px;height:44px;border-radius:var(--r-xs);flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:20px}
.rm-nm{font-size:15px;font-weight:800}
.rm-sub{font-size:12px;color:var(--muted);font-weight:600;margin-top:2px}

/*=== PAYMENT ===*/
.pay-opt{background:var(--white);border:2px solid var(--border);border-radius:var(--r);padding:15px 16px;display:flex;align-items:center;gap:14px;margin-bottom:12px;cursor:pointer;transition:all .2s}
.pay-opt.sel{border-color:var(--teal);background:rgba(13,115,119,.025);box-shadow:0 0 0 1px var(--teal)}
.pay-opt:active{transform:scale(.99)}
.pay-logo{width:52px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:900;letter-spacing:.01em;flex-shrink:0}
.lg-gcash{background:#007aff;color:white}
.lg-card{background:linear-gradient(135deg,#1a1a2e,#1e3a5f);color:white}
.lg-maya{background:linear-gradient(135deg,#00c851,#007a2f);color:white}
.pay-info strong{display:block;font-size:15px;font-weight:800}
.pay-info small{font-size:12px;color:var(--muted);font-weight:600}
.pay-radio{margin-left:auto;width:22px;height:22px;border-radius:50%;border:2px solid var(--border);background:var(--cream);transition:all .2s;flex-shrink:0;position:relative}
.pay-opt.sel .pay-radio{border-color:var(--teal);background:var(--teal)}
.pay-opt.sel .pay-radio::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:8px;height:8px;border-radius:50%;background:white}

.cform{background:var(--cream);border-radius:var(--r-sm);padding:15px;margin-top:8px;display:none}
.cform.show{display:block}
.gcash-box{background:var(--cream);border-radius:var(--r-sm);padding:18px;margin-top:8px;text-align:center;display:none}
.maya-box{background:var(--cream);border-radius:var(--r-sm);padding:18px;margin-top:8px;text-align:center;display:none}

/*=== PROCESSING ===*/
.proc-screen{display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:85vh;padding:40px;text-align:center}
.proc-ring{width:72px;height:72px;border-radius:50%;border:5px solid var(--cream);border-top:5px solid var(--teal);animation:spin .75s linear infinite;margin-bottom:28px}
@keyframes spin{to{transform:rotate(360deg)}}
.proc-ring2{width:50px;height:50px;border-radius:50%;border:4px solid var(--cream);border-top:4px solid var(--gold);animation:spin .9s linear infinite reverse;position:absolute;top:11px;left:11px}
.proc-wrap{position:relative}

/*=== CONFIRM SCREEN ===*/
.conf-wrap{display:flex;flex-direction:column;align-items:center;padding:48px 22px 40px;text-align:center}
.conf-ring{width:90px;height:90px;border-radius:50%;background:rgba(0,184,148,.1);border:2.5px solid rgba(0,184,148,.3);display:flex;align-items:center;justify-content:center;margin-bottom:22px;animation:popIn .55s cubic-bezier(.34,1.56,.64,1)}
.conf-ring svg{width:42px;height:42px;stroke:var(--success);fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
@keyframes popIn{from{transform:scale(0);opacity:0}to{transform:scale(1);opacity:1}}
.conf-ref{background:var(--cream);border:2px dashed var(--border2);border-radius:var(--r-sm);padding:12px 28px;font-family:'Yeseva One',serif;font-size:26px;color:var(--teal);letter-spacing:.1em;margin:16px 0}
.conf-card{width:100%;background:var(--white);border:1.5px solid var(--border);border-radius:var(--r);padding:16px;text-align:left;box-shadow:var(--shadow)}

/*=== ITINERARY ===*/
.itin-hero{background:linear-gradient(155deg,#0a2a1a,#0d3a20,#0a3a2a);padding:50px 20px 32px;color:white;position:relative;overflow:hidden}
.itin-hero::before{content:'🌊';font-size:120px;position:absolute;bottom:-20px;right:-20px;opacity:.06}
.day-card{background:var(--white);border-radius:var(--r);border:1.5px solid var(--border);margin-bottom:16px;overflow:hidden;box-shadow:var(--shadow)}
.day-hd{display:flex;align-items:center;gap:12px;padding:14px 16px;color:white}
.day-num-badge{font-family:'Yeseva One',serif;font-size:13px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.2);border-radius:20px;padding:3px 10px;letter-spacing:.04em}
.day-title{font-size:14px;font-weight:800;letter-spacing:.01em}
.act{display:flex;gap:12px;padding:12px 16px;border-bottom:1px solid var(--border);transition:background .15s}
.act:last-child{border-bottom:none}
.act:active{background:var(--cream)}
.act-time{font-size:11px;color:var(--muted);font-weight:800;width:52px;flex-shrink:0;padding-top:3px;letter-spacing:.02em}
.act-ico{font-size:20px;flex-shrink:0}
.act-info strong{display:block;font-size:14px;font-weight:800;color:var(--text)}
.act-info small{font-size:12px;color:var(--muted);line-height:1.55;margin-top:2px;display:block;font-weight:500}

.attr-scroll{display:flex;gap:12px;overflow-x:auto;padding:0 18px 4px;scrollbar-width:none}
.attr-scroll::-webkit-scrollbar{display:none}
.acard{flex-shrink:0;width:150px;background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-sm);overflow:hidden;box-shadow:var(--shadow);cursor:pointer;transition:all .2s}
.acard:active{transform:scale(.97)}
.acard-img{height:90px;display:flex;align-items:center;justify-content:center;font-size:34px}
.acard-body{padding:10px 11px}
.acard-name{font-size:12px;font-weight:800;line-height:1.3;color:var(--text)}
.acard-meta{font-size:11px;color:var(--muted);margin-top:3px;font-weight:600}

/*=== ADMIN ===*/
.admin-login{padding:52px 24px;text-align:center}
.admin-av{width:76px;height:76px;border-radius:50%;background:linear-gradient(135deg,var(--teal),var(--teal2));display:flex;align-items:center;justify-content:center;font-size:32px;margin:0 auto 20px;box-shadow:0 4px 20px rgba(13,115,119,.4)}
.stats-g{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:16px}
.stat{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r-sm);padding:16px 14px;text-align:center;box-shadow:var(--shadow);transition:transform .2s}
.stat:active{transform:scale(.97)}
.stat-n{font-family:'Yeseva One',serif;font-size:28px;color:var(--teal);line-height:1}
.stat-l{font-size:10px;color:var(--muted);font-weight:800;margin-top:5px;text-transform:uppercase;letter-spacing:.06em}
.brec{background:var(--white);border:1.5px solid var(--border);border-radius:var(--r);padding:15px 16px;margin:0 16px 12px;box-shadow:var(--shadow);transition:all .2s;cursor:pointer}
.brec:active{border-color:var(--teal);transform:scale(.995)}
.brec-hd{display:flex;justify-content:space-between;align-items:flex-start}
.brec-guest{font-size:16px;font-weight:800;color:var(--text)}
.brec-room{font-size:12px;color:var(--muted);font-weight:600;margin-top:2px}
.brec-amt{font-family:'Yeseva One',serif;font-size:21px;color:var(--teal)}
.brec-meta{font-size:13px;color:var(--muted);font-weight:600;line-height:1.8;margin-top:8px}
.brec-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:8px}
.btag{font-size:11px;background:rgba(13,115,119,.08);border:1px solid rgba(13,115,119,.18);padding:3px 9px;border-radius:20px;color:var(--teal);font-weight:700}
.brec-ref{font-size:11px;font-weight:700;color:var(--muted2);margin-top:7px;display:block;letter-spacing:.04em}
.status-chip{display:inline-flex;align-items:center;gap:4px;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.05em}
.sc-confirmed{background:rgba(0,184,148,.1);color:var(--success)}

/*=== BUTTONS ===*/
.btn{width:100%;background:linear-gradient(135deg,var(--teal),var(--teal2));color:white;border:none;border-radius:var(--r-sm);padding:15px;font-family:'Nunito',sans-serif;font-size:15px;font-weight:800;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:8px;transition:all .2s;box-shadow:0 4px 16px rgba(13,115,119,.3);letter-spacing:.02em;margin-bottom:10px}
.btn:active{transform:scale(.97);box-shadow:none}
.btn:disabled{opacity:.45;cursor:not-allowed;transform:none;box-shadow:none}
.btn.outline{background:transparent;color:var(--teal);border:2px solid var(--teal);box-shadow:none}
.btn.outline:active{background:rgba(13,115,119,.05)}
.btn.gold-btn{background:linear-gradient(135deg,var(--gold),var(--gold2));box-shadow:0 4px 16px rgba(232,160,32,.35)}
.btn.success-btn{background:linear-gradient(135deg,var(--success),#00a381);box-shadow:0 4px 16px rgba(0,184,148,.35)}

/*=== TOP BAR ===*/
.topbar{background:var(--white);border-bottom:1px solid var(--border);padding:14px 16px;display:flex;align-items:center;gap:12px;position:sticky;top:0;z-index:100;box-shadow:0 2px 12px rgba(10,22,40,.05)}
.topbar-title{font-family:'DM Serif Display',serif;font-size:20px;flex:1;color:var(--text)}
.back-b{width:38px;height:38px;border-radius:50%;background:var(--cream);border:1.5px solid var(--border);display:flex;align-items:center;justify-content:center;cursor:pointer;flex-shrink:0;transition:all .15s}
.back-b:active{transform:scale(.88)}
.back-b svg{width:18px;height:18px;stroke:var(--text);fill:none;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/*=== MISC ===*/
.info-box{background:linear-gradient(135deg,rgba(232,160,32,.1),rgba(232,160,32,.06));border:1.5px solid rgba(232,160,32,.3);border-radius:var(--r-sm);padding:13px 15px;font-size:13px;color:#7a5010;font-weight:600;line-height:1.6;margin-bottom:16px}
.info-box strong{font-weight:800;color:#5a3a05}
.empty-state{text-align:center;padding:52px 24px;color:var(--muted)}
.empty-ico{font-size:52px;margin-bottom:12px}
.empty-state p{font-size:14px;line-height:1.65;font-weight:500}
.divider{height:1px;background:var(--border);margin:14px 0}

/*=== TOAST ===*/
.toast{position:fixed;bottom:calc(var(--tab) + 14px);left:50%;transform:translateX(-50%) translateY(20px);background:var(--deep);color:white;font-size:13px;font-weight:700;padding:11px 22px;border-radius:30px;z-index:400;opacity:0;transition:all .3s;white-space:nowrap;pointer-events:none;box-shadow:0 4px 20px rgba(10,22,40,.35);max-width:360px;text-align:center}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/*=== RIPPLE ===*/
.ripple{position:relative;overflow:hidden}
.ripple::after{content:'';position:absolute;border-radius:50%;background:rgba(255,255,255,.35);transform:scale(0);animation:ripple-out .6s ease-out;pointer-events:none}
@keyframes ripple-out{to{transform:scale(4);opacity:0}}
</style>
