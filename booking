<!-- TOAST -->
<div class="toast" id="toast"></div>

<script>
// ============ DATA ============
const ROOMS = [
  {id:0,name:'Deluxe Room',    price:2800,cap:2,sqm:28,bg:'ra1',icon:'🛏️'},
  {id:1,name:'Superior Room',  price:3800,cap:3,sqm:38,bg:'ra2',icon:'🌴'},
  {id:2,name:'Family Suite',   price:5500,cap:5,sqm:58,bg:'ra3',icon:'👨‍👩‍👧‍👦'},
  {id:3,name:'Presidential Suite',price:8500,cap:4,sqm:85,bg:'ra4',icon:'🌟'}
];
const ADDONS = {
  tour:     {name:'Pangasinan Island Tour',price:(g,n)=>1000*g,  lbl:(g,n)=>`₱1,000 × ${g} guest${g>1?'s':''}`},
  pickup:   {name:'Airport / Terminal Pickup',price:(g,n)=>600,  lbl:(g,n)=>'₱600 flat rate'},
  breakfast:{name:'Breakfast Buffet',price:(g,n)=>380*g*n,       lbl:(g,n)=>`₱380 × ${g} × ${n} nights`},
  spa:      {name:'Hilot Spa Package',price:(g,n)=>900*n,         lbl:(g,n)=>`₱900 × ${n} night${n>1?'s':''}`}
};
const PROMOS = {SUMMER10:.10,ANDA20:.20,WELCOME15:.15};
const STEP_NAMES = ['📅 Select Dates','✨ Add-ons','👤 Guest Info','📋 Summary','💳 Payment'];

// ============ STATE ============
let currentRoom=null, step=0, guests=1, nights=0;
let checkIn='',checkOut='';
let addons=new Set();
let gName='',gEmail='',gPhone='',gReq='';
let promoCode='',promoRate=0;
let payMethod=null;
let grandTotal=0;
let bookings=[];
let refN=2000;
let admAuth=false;

// ============ SPLASH ============
window.addEventListener('load',()=>{
  // Generate particles
  ['particles','hero-particles'].forEach(id=>{
    const p=document.getElementById(id); if(!p)return;
    for(let i=0;i<18;i++){
      const d=document.createElement('div');
      d.className='particle';
      d.style.cssText=`left:${Math.random()*100}%;top:${Math.random()*100}%;animation-duration:${3+Math.random()*4}s;animation-delay:${Math.random()*3}s;width:${2+Math.random()*3}px;height:${2+Math.random()*3}px;opacity:${.2+Math.random()*.4}`;
      p.appendChild(d);
    }
  });
  // Dismiss splash
  setTimeout(()=>{
    document.getElementById('splash').classList.add('hide');
    setTimeout(()=>document.getElementById('splash').style.display='none',700);
  },2200);
});

// ============ NAVIGATION ============
const NAVMAP={'s-home':'bn-home','s-itineraries':'bn-itin','s-admin':'bn-admin'};
function nav(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  document.querySelectorAll('.bnav-btn').forEach(b=>b.classList.remove('active'));
  if(NAVMAP[id]) document.getElementById(NAVMAP[id]).classList.add('active');
  const hideNav=['s-confirm'].includes(id);
  document.querySelector('.bnav').style.display=hideNav?'none':'flex';
}

// ============ ROOM SELECTION ============
function pickRoom(id,el){
  currentRoom=ROOMS[id];
  guests=1; nights=0; checkIn='';checkOut=''; addons.clear(); promoCode='';promoRate=0; payMethod=null;
  // Reset step UI
  document.getElementById('d-rm-name').textContent=currentRoom.name;
  document.getElementById('d-rm-price').textContent='₱'+currentRoom.price.toLocaleString()+' / night';
  document.getElementById('d-maxcap').textContent=currentRoom.cap;
  document.getElementById('d-rm-img').className='rm-img '+currentRoom.bg;
  document.getElementById('d-rm-img').textContent=currentRoom.icon;
  document.getElementById('gcount').textContent=1;
  document.getElementById('ci').value='';
  document.getElementById('co').value='';
  const today=new Date().toISOString().split('T')[0];
  document.getElementById('ci').min=today;
  document.getElementById('co').min=today;
  ['tour','pickup','breakfast','spa'].forEach(a=>{
    const el=document.getElementById('ao-'+a);
    if(el)el.classList.remove('sel');
  });
  document.getElementById('promo-inp').value='';
  document.getElementById('promo-ok').style.display='none';
  document.getElementById('promo-err').style.display='none';
  document.querySelectorAll('.pay-opt').forEach(p=>p.classList.remove('sel'));
  document.getElementById('card-form').classList.remove('show');
  document.getElementById('gcash-box').style.display='none';
  document.getElementById('maya-box').style.display='none';
  document.getElementById('pay-btn').disabled=true;
  calcNights();
  updateAddonLabels();
  showStep(0);
  nav('s-booking');
  showToast('🛏️ '+currentRoom.name+' selected!');
}

// ============ STEP CONTROL ============
function showStep(n){
  for(let i=0;i<=5;i++){
    const el=document.getElementById('sp'+i);
    if(!el)continue;
    el.style.display=(i===n)?(i===5?'flex':'block'):'none';
  }
  step=n;
  if(n<=4){
    document.getElementById('sbar-name').textContent=STEP_NAMES[n]||'';
    document.getElementById('sbar-count').textContent=`Step ${n+1} / 5`;
    document.querySelector('.sbar').style.display='block';
    document.getElementById('crumbs').style.display='flex';
    for(let i=0;i<5;i++){
      const s=document.getElementById('ss'+i);
      s.className='sseg'+(i<n?' done':i===n?' active':'');
      const c=document.getElementById('cr'+i);
      c.className='scrumb-dot'+(i<n?' done':i===n?' active':'');
      if(i<4){
        const cl=document.getElementById('cl'+i);
        cl.className='scrumb-line'+(i<n?' done':'');
      }
    }
  } else {
    document.querySelector('.sbar').style.display='none';
    document.getElementById('crumbs').style.display='none';
  }
}

function nextS(){
  if(step===0){
    if(!checkIn||!checkOut||nights<1){showToast('⚠️ Please pick valid check-in & check-out dates');return;}
    updateAddonLabels();
    updateAddonTotal();
  }
  if(step===1){updateAddonTotal();}
  if(step===2){
    gName=document.getElementById('g-name').value.trim();
    gEmail=document.getElementById('g-email').value.trim();
    gPhone=document.getElementById('g-phone').value.trim();
    gReq=document.getElementById('g-req').value.trim();
    if(!gName){showToast('⚠️ Please enter your full name');return;}
    if(!gEmail||!gEmail.includes('@')){showToast('⚠️ Please enter a valid email');return;}
    buildSummary();
  }
  if(step===3){
    document.getElementById('py-total').textContent='₱'+grandTotal.toLocaleString();
  }
  showStep(step+1);
  const sp=document.getElementById('sp'+(step));
  if(sp&&sp.scrollTop!==undefined)sp.scrollTop=0;
}

function prevS(){
  if(step===0){nav('s-home');return;}
  showStep(step-1);
}

// ============ DATES ============
function calcNights(){
  const ci=document.getElementById('ci').value;
  const co=document.getElementById('co').value;
  document.getElementById('dci').classList.toggle('has-val',!!ci);
  document.getElementById('dco').classList.toggle('has-val',!!co);
  if(ci&&co){
    const n=Math.round((new Date(co)-new Date(ci))/86400000);
    if(n>0){
      nights=n; checkIn=ci; checkOut=co;
      document.getElementById('np-n').textContent=n;
      const sub=currentRoom?currentRoom.price*n:0;
      document.getElementById('np-amt').textContent='₱'+sub.toLocaleString();
    } else {
      nights=0;
      document.getElementById('np-n').textContent='0';
      document.getElementById('np-amt').textContent='⚠️ invalid';
    }
  } else {
    nights=0;
    document.getElementById('np-n').textContent='0';
    document.getElementById('np-amt').textContent='₱ —';
  }
}

// ============ GUESTS ============
function chGuest(d){
  guests=Math.max(1,Math.min((guests+d),currentRoom?currentRoom.cap:10));
  document.getElementById('gcount').textContent=guests;
  updateAddonLabels();
  updateAddonTotal();
}

// ============ ADDONS ============
function togAddon(id){
  addons.has(id)?addons.delete(id):addons.add(id);
  document.getElementById('ao-'+id).classList.toggle('sel',addons.has(id));
  updateAddonTotal();
  showToast(addons.has(id)?'✓ '+ADDONS[id].name+' added':'Removed: '+ADDONS[id].name);
}

function updateAddonLabels(){
  document.getElementById('ao-tour-lbl').textContent=ADDONS.tour.lbl(guests,nights);
  document.getElementById('ao-bfast-lbl').textContent=ADDONS.breakfast.lbl(guests,nights);
  document.getElementById('ao-spa-lbl').textContent=ADDONS.spa.lbl(guests,nights);
}

function addonAmt(id){return ADDONS[id].price(guests,nights);}

function updateAddonTotal(){
  let t=0; addons.forEach(id=>t+=addonAmt(id));
  document.getElementById('ao-total').textContent='₱'+t.toLocaleString();
}

// ============ PROMO ============
function applyPromo(){
  const code=document.getElementById('promo-inp').value.trim().toUpperCase();
  const ok=document.getElementById('promo-ok'),err=document.getElementById('promo-err');
  if(PROMOS[code]){
    promoCode=code; promoRate=PROMOS[code];
    document.getElementById('promo-ok-txt').textContent=`"${code}" applied — ${(promoRate*100).toFixed(0)}% off room price!`;
    ok.style.display='block'; err.style.display='none';
    buildSummary();
    showToast('🎉 Promo code applied!');
  } else {
    promoCode=''; promoRate=0;
    ok.style.display='none'; err.style.display='block';
    showToast('❌ Invalid promo code');
    setTimeout(()=>err.style.display='none',3000);
  }
}

// ============ SUMMARY ============
function buildSummary(){
  const r=currentRoom;
  const rSub=r.price*nights;
  let aoSub=0;
  // room
  document.getElementById('s-rm-img').className='rm-img '+r.bg;
  document.getElementById('s-rm-img').textContent=r.icon;
  document.getElementById('s-rm-nm').textContent=r.name;
  document.getElementById('s-rm-meta').textContent=r.sqm+'m² · '+guests+' guest'+(guests>1?'s':'');
  document.getElementById('s-rm-line').textContent='₱'+r.price.toLocaleString()+'/night';
  document.getElementById('s-nights-val').textContent=nights+' night'+(nights>1?'s':'');
  document.getElementById('s-rm-sub').textContent='₱'+rSub.toLocaleString();
  // addons
  let aoHtml='';
  if(!addons.size) aoHtml='<div style="font-size:13px;color:var(--muted);font-weight:600">None selected</div>';
  else addons.forEach(id=>{const p=addonAmt(id);aoSub+=p;aoHtml+=`<div class="price-row" style="font-size:13px"><span>${ADDONS[id].name}</span><span class="v">₱${p.toLocaleString()}</span></div>`;});
  document.getElementById('s-addons-list').innerHTML=aoHtml;
  // guest
  document.getElementById('s-gname').textContent=gName;
  document.getElementById('s-gemail').textContent=gEmail;
  document.getElementById('s-gcount').textContent=guests+' guest'+(guests>1?'s':'');
  // totals
  const disc=Math.round(rSub*promoRate);
  grandTotal=rSub+aoSub-disc;
  document.getElementById('t-room').textContent='₱'+rSub.toLocaleString();
  document.getElementById('t-addons').textContent='₱'+aoSub.toLocaleString();
  if(disc>0){
    document.getElementById('t-disc-row').style.display='flex';
    document.getElementById('t-disc-lbl').textContent='Promo ('+promoCode+' −'+(promoRate*100).toFixed(0)+'%)';
    document.getElementById('t-disc').textContent='−₱'+disc.toLocaleString();
  } else document.getElementById('t-disc-row').style.display='none';
  document.getElementById('t-total').textContent='₱'+grandTotal.toLocaleString();
}

// ============ PAYMENT ============
function selPay(m){
  payMethod=m;
  document.querySelectorAll('.pay-opt').forEach(p=>p.classList.remove('sel'));
  document.getElementById('py-'+m).classList.add('sel');
  document.getElementById('card-form').classList.toggle('show',m==='card');
  document.getElementById('gcash-box').style.display=m==='gcash'?'block':'none';
  document.getElementById('maya-box').style.display=m==='maya'?'block':'none';
  document.getElementById('pay-btn').disabled=false;
  document.getElementById('pay-btn').textContent={gcash:'Pay via GCash 📱',maya:'Pay via Maya 💚',card:'Pay via Card 💳'}[m]+' — ₱'+grandTotal.toLocaleString();
}

function fmtCard(el){let v=el.value.replace(/\D/g,'').substring(0,16);el.value=v.replace(/(.{4})/g,'$1 ').trim();}
function fmtExp(el){let v=el.value.replace(/\D/g,'');if(v.length>2)v=v.substring(0,2)+' / '+v.substring(2,4);el.value=v;}

function doPay(){
  if(payMethod==='card'){
    const n=document.getElementById('cc-num').value.replace(/\s/g,'');
    if(n.length<16){showToast('⚠️ Enter a valid 16-digit card number');return;}
    if(!document.getElementById('cc-exp').value){showToast('⚠️ Enter card expiry');return;}
  }
  if(payMethod==='gcash'&&document.getElementById('gcash-num').value.trim().length<11){showToast('⚠️ Enter your GCash number');return;}
  if(payMethod==='maya'&&document.getElementById('maya-num').value.trim().length<11){showToast('⚠️ Enter your Maya number');return;}

  document.getElementById('sp4').style.display='none';
  document.getElementById('sp5').style.display='flex';
  document.querySelector('.sbar').style.display='none';
  document.getElementById('crumbs').style.display='none';
  // Animate proc messages
  const msgs=['Verifying payment…','Checking availability…','Securing your reservation…','Almost done…'];
  let mi=0;
  const iv=setInterval(()=>{mi=(mi+1)%msgs.length;document.getElementById('proc-msg').textContent=msgs[mi];},700);
  setTimeout(()=>{clearInterval(iv);completeBooking();},3000);
}

// ============ COMPLETE BOOKING ============
function completeBooking(){
  refN++;
  const ref='AND-'+String(refN).padStart(5,'0');
  const aoNames=[...addons].map(a=>ADDONS[a].name);
  const rec={ref,name:gName,email:gEmail,phone:gPhone,req:gReq,
    room:currentRoom.name,roomId:currentRoom.id,roomBg:currentRoom.bg,roomIcon:currentRoom.icon,
    checkIn,checkOut,nights,guests,addons:aoNames,promo:promoCode,
    total:grandTotal,payMethod,
    ts:new Date().toLocaleString('en-PH',{dateStyle:'medium',timeStyle:'short'})
  };
  bookings.push(rec);
  // Fill confirm
  document.getElementById('c-ref').textContent=ref;
  document.getElementById('c-name').textContent=gName;
  document.getElementById('c-room').textContent=currentRoom.name;
  document.getElementById('c-in').textContent=fmtD(checkIn);
  document.getElementById('c-out').textContent=fmtD(checkOut);
  document.getElementById('c-g').textContent=guests+' guest'+(guests>1?'s':'');
  document.getElementById('c-ao').textContent=aoNames.length?aoNames.join(', '):'None';
  document.getElementById('c-pay').textContent={gcash:'GCash 📱',maya:'Maya 💚',card:'Credit / Debit Card 💳'}[payMethod]||'—';
  document.getElementById('c-total').textContent='₱'+grandTotal.toLocaleString();
  nav('s-confirm');
  showToast('🎉 Booking confirmed! Ref: '+ref);
}

function fmtD(s){
  if(!s)return'—';
  return new Date(s+'T00:00:00').toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'});
}

// ============ ADMIN ============
function goAdmin(){
  nav('s-admin');
  if(admAuth)renderAdmin();
}

function admLogin(){
  const p=document.getElementById('adm-pass').value;
  if(p==='admin123'){
    admAuth=true;
    document.getElementById('adm-gate').style.display='none';
    const d=document.getElementById('adm-dash');d.style.display='flex';
    renderAdmin();
    showToast('👋 Welcome, Admin!');
  } else {
    showToast('❌ Wrong password');
    document.getElementById('adm-pass').value='';
    document.getElementById('adm-pass').focus();
  }
}

function admLogout(){
  admAuth=false;
  document.getElementById('adm-gate').style.display='block';
  document.getElementById('adm-dash').style.display='none';
  document.getElementById('adm-pass').value='';
  nav('s-home');
  showToast('Logged out successfully');
}

function renderAdmin(){
  const total=bookings.length;
  const rev=bookings.reduce((s,b)=>s+b.total,0);
  const tg=bookings.reduce((s,b)=>s+b.guests,0);
  const tn=bookings.reduce((s,b)=>s+b.nights,0);
  document.getElementById('st-total').textContent=total;
  document.getElementById('st-rev').textContent=total?'₱'+rev.toLocaleString():'₱0';
  document.getElementById('st-guests').textContent=tg;
  document.getElementById('st-nights').textContent=tn;
  document.getElementById('adm-rec-count').textContent=total+' record'+(total!==1?'s':'');
  const cont=document.getElementById('adm-recs');
  if(!total){
    cont.innerHTML='<div class="empty-state"><div class="empty-ico">📭</div><p>No bookings recorded yet.<br>Complete a booking to see it here.</p></div>';
    return;
  }
  cont.innerHTML=bookings.slice().reverse().map(b=>`
    <div class="brec">
      <div class="brec-hd">
        <div>
          <div class="brec-guest">${b.name}</div>
          <div class="brec-room">${b.room} · ${b.nights} night${b.nights>1?'s':''}</div>
        </div>
        <div><div class="brec-amt">₱${b.total.toLocaleString()}</div><span class="status-chip sc-confirmed">✓ Confirmed</span></div>
      </div>
      <div class="brec-meta">
        📅 ${fmtD(b.checkIn)} → ${fmtD(b.checkOut)}<br>
        👤 ${b.guests} guest${b.guests>1?'s':''} &nbsp;·&nbsp; 📧 ${b.email}<br>
        💳 ${{gcash:'GCash',maya:'Maya',card:'Credit/Debit Card'}[b.payMethod]||b.payMethod}${b.promo?' · 🏷️ '+b.promo:''}${b.phone?' · 📞 '+b.phone:''}
      </div>
      ${b.addons.length?`<div class="brec-tags">${b.addons.map(a=>`<span class="btag">${a}</span>`).join('')}</div>`:''}
      ${b.req?`<div style="font-size:12px;color:var(--muted);font-weight:600;margin-top:7px;line-height:1.5;background:var(--cream);border-radius:var(--r-xs);padding:8px 10px">💬 ${b.req}</div>`:''}
      <div class="brec-ref">Ref: ${b.ref} &nbsp;·&nbsp; ${b.ts}</div>
    </div>
  `).join('');
}

// ============ TOAST ============
let _tt;
function showToast(msg){
  const t=document.getElementById('toast');
  t.textContent=msg; t.classList.add('show');
  clearTimeout(_tt); _tt=setTimeout(()=>t.classList.remove('show'),2600);
}

// ============ RIPPLE ============
document.addEventListener('click',e=>{
  const el=e.target.closest('.ripple');
  if(!el)return;
  const r=el.getBoundingClientRect();
  const sz=Math.max(r.width,r.height)*2;
  el.style.setProperty('--rr',sz/2+'px');
  el.style.setProperty('--rx',(e.clientX-r.left)+'px');
  el.style.setProperty('--ry',(e.clientY-r.top)+'px');
  el.style.setProperty('--rw',sz+'px');
  el.style.setProperty('--rh',sz+'px');
  const s=el.style;
  // simple approach: just flash opacity
  el.style.transition='opacity .1s';
  el.style.opacity='.85';
  setTimeout(()=>{el.style.opacity='1';},100);
});
</script>
